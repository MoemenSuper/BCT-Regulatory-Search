# Copy to .env next to docker-compose.yml. Do not commit real secrets.

# Required: folder on THIS machine that contains the BCT PDF corpus
BCT_DOCUMENTS_HOST=C:\path\to\BCT-PDF-corpus

# Required: first administrator (created on first start)
BCT_BOOTSTRAP_ADMIN_EMAIL=admin@example.tn
BCT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# Required for cloud answers / search / hard-page repair
GROQ_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
# Optional extras for pilot ingest (rotate on Gemini quota). Production can use one key.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional
BCT_PUBLISH_PORT=8080
BCT_COOKIE_SECURE=0
# Behind HTTPS: BCT_COOKIE_SECURE=1
