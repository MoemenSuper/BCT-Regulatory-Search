# Copy to .env next to docker-compose.yml. Do not commit real secrets.

# PDF corpus is baked into the image from ./documents at build time.
# Optional: host folder to override the baked-in corpus (uncomment the bind
# mount in docker-compose.yml first).
# BCT_DOCUMENTS_HOST=C:\path\to\BCT-PDF-corpus

# Required: first administrator (created on first start)
BCT_BOOTSTRAP_ADMIN_EMAIL=admin@example.tn
BCT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# Answer model: ONE key is enough. Fill the key of the provider you use; the app answers with
# the first provider that has a key (OpenAI, Claude, Groq, then Gemini), or the one named in
# BCT_ANSWER_PROVIDER. Everything below can also be changed later in Admin > Configuration.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# BCT_ANSWER_PROVIDER=openai|anthropic|gemini|groq
# Models (defaults shown):
# BCT_OPENAI_MODEL=gpt-6.1-sol
# BCT_ANTHROPIC_MODEL=claude-sonnet-5-5
# BCT_GEMINI_ANSWER_MODEL=gemini-3.8-flash
# BCT_GROQ_MODEL=openai/gpt-oss-120b

# Search speed on a server without GPU: auto (best quality) or fast (8-bit reranker, about 2x
# faster, about 5 points less accurate). Also in Admin > Configuration.
# BCT_SPEED_MODE=auto

# Cloud profile only: Voyage search (GEMINI_API_KEY above also reads scanned pages there)
VOYAGE_API_KEY=
# Visual ingest backend: omit to follow profile (local/local_hybrid → EasyOCR+PaddleOCR-VL; cloud → Gemini).
# BCT_VISUAL_BACKEND=local|gemini|off
# Local visual GPU (host run_api): EasyOCR uses the work venv Torch CUDA; PaddleOCR-VL runs in a
# separate torch-free GPU venv (Windows cannot load Torch+Paddle cuDNN in one process).
# BCT_EASYOCR_GPU=1
# BCT_PADDLE_DEVICE=gpu
# BCT_PADDLE_PYTHON=C:\path\to\paddleocr-vl-bench\.venv\Scripts\python.exe
# Optional extras for pilot ingest (rotate on Gemini quota). Production can use one key.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Optional: Arabic Gemini policy — all | risk (default) | off
# Optional: primary / fallback / full model chain for visual ingest (comma-separated)
# BCT_GEMINI_MODEL=gemini-3.8-flash   (page reading; the answer model is BCT_GEMINI_ANSWER_MODEL)
# BCT_GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# BCT_GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Optional
BCT_PUBLISH_PORT=8080
BCT_COOKIE_SECURE=0
# Default runtime profile is local_hybrid (local e5+BGE search + the answer model above).
# BCT_DEFAULT_PROFILE=local_hybrid
# Ingest: local/local_hybrid skip Voyage/Google embeds (Chroma/e5 only). Force cloud
# index updates with BCT_INGEST_CLOUD_INDEX=1 (needed when profile=cloud, or to refresh
# Voyage/Google indexes while staying on local_hybrid for chat).
# BCT_INGEST_CLOUD_INDEX=0
# Behind HTTPS: BCT_COOKIE_SECURE=1

# Optional: Langfuse ingestion traces (one trace per uploaded PDF). Unset keys = tracing off.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
